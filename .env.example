# Use mock data without a running Laravel backend (default)
VITE_DATA_SOURCE=mock
# Set to 'api' to enable connected PMS modules including staff account security.
# Reservations and billing are still mock previews.
VITE_API_URL=http://localhost:8000/api/v1

# Use the same hostname for frontend and Laravel, e.g. localhost for both.
# API token mode defaults to memory-only; refreshing signs out unless persistence is enabled.

# Phase 17: opt-in Sanctum cookie SPA sessions (must match backend setup).
# Use 'cookie' only after enabling SPA_SESSION_ENABLED=true in Laravel.
# 'bearer' uses token authentication; use VITE_AUTH_PERSISTENCE only for temporary staging.
VITE_AUTH_MODE=bearer

# OPTIONAL for separate Railway-generated staging domains only.
# Keep the bearer token in sessionStorage so refresh restores the session.
# sessionStorage is JavaScript-readable and vulnerable to XSS.
# Use same-site HttpOnly Sanctum cookies on custom domains for production.
# VITE_AUTH_PERSISTENCE=session
