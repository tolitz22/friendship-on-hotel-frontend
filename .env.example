# Use mock data without a running Laravel backend (default)
VITE_DATA_SOURCE=mock
# Set to 'api' to enable staff sign-in and LIVE Guests only; other screens remain labeled mock previews.
VITE_API_URL=http://localhost:8000/api/v1

# Use the same hostname for frontend and Laravel, e.g. localhost for both.
# API mode login uses short-lived memory-only bearer token; reload signs out.
