# Use mock data without a running Laravel backend (default)
VITE_DATA_SOURCE=mock
# Set to 'api' to enable connected PMS modules including staff account security.
# Reservations and billing are still mock previews.
VITE_API_URL=http://localhost:8000/api/v1

# Use the same hostname for frontend and Laravel, e.g. localhost for both.
# API mode login uses short-lived memory-only bearer token; reload signs out.

# Phase 17: opt-in Sanctum cookie SPA sessions (must match backend setup).
# Use 'cookie' only after enabling SPA_SESSION_ENABLED=true in Laravel.
# 'bearer' retains the previous memory-only token development flow.
VITE_AUTH_MODE=bearer
